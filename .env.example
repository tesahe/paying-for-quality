# ========================================================
# Example environment variables (CIT 381 — Paying for Quality)
# Copy this file to .env and fill in local values.
# NEVER commit .env or real credentials.
# ========================================================

# Supabase Postgres connection string (Dashboard → Connect).
# Use the session pooler string if your network is IPv4-only.
# Format: postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_URL=

# Optional: a separate Supabase database for opt-in integration tests
# (pytest -m supabase). Leave blank to skip them; plain `pytest` never needs it.
PFQ_TEST_DATABASE_URL=

# LLM provider for extraction and judging (provider TBD).
# Leave blank for local development; tests use fake adapters and need no key.
LLM_API_KEY=

# Monthly LLM spending cap in USD (kept low; value TBD)
LLM_MONTHLY_BUDGET_USD=
